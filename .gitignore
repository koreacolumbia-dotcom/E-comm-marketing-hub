.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*service-account*.json
*service_account*.json
credentials*.json
secrets*.json

# Local data exports containing customer-level data
exports/
private_data/
customer_exports/
crm_exports/
